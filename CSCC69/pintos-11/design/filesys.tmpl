>> A1: Copy here the declaration of each new or changed `struct' or
>> `struct' member, global or static variable, `typedef', or
>> enumeration.  Identify the purpose of each in 25 words or less.

#define DIRECT_CNT 123
- the number of direct block pointers within an inode, 
used for directly pointing to data blocks.

#define INDIRECT_CNT 1
- the number of indirect block pointers, used to access 
additional data blocks through a single level of indirection.

#define DBL_INDIRECT_CNT 1
- the number of double indirect block pointers, used to access 
data blocks through two levels of indirection.

#define PTRS_PER_SECTOR ((off_t)(BLOCK_SECTOR_SIZE / sizeof(block_sector_t)))
- the number of pointers that can be stored in a single block sector.

#define SECTOR_CNT (DIRECT_CNT + INDIRECT_CNT + DBL_INDIRECT_CNT)
- the total number of block pointers within an inode, including direct, 
indirect, and double indirect.

#define INODE_SPAN ((DIRECT_CNT + PTRS_PER_SECTOR * INDIRECT_CNT + 
PTRS_PER_SECTOR * PTRS_PER_SECTOR * DBL_INDIRECT_CNT) * BLOCK_SECTOR_SIZE)
- the maximum file size an inode can address, considering direct, indirect, 
and double indirect blocks.

struct inode_disk {
    block_sector_t sectors[SECTOR_CNT];
    enum inode_type type;
    off_t length;
    unsigned magic;
};
- an on-disk inode structure containing pointers to data blocks 
and metadata such as type and file length.

struct inode {
    struct list_elem elem;
    block_sector_t sector;
    int open_cnt;
    bool removed;
    struct lock lock;
};
- an in-memory inode, containing essential file metadata and 
synchronization primitives

