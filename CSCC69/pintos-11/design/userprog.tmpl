// This structure tracks process information in Pintos. 
// It helps manage process execution, synchronization, and termination.
struct process_control_block
{
  pid_t pid;             //Stores the process ID.
  const char *cmdline;   // Holds the command-line arguments for the process.
  struct list_elem elem; // Used for managing the process in a list.
  bool wait;          // Indicates if the parent process is waiting for this process to exit.
  bool exited;           // Marks if the process has already exited.
  bool orphan;           // Identifies if the process has lost its parent.
  int32_t exit_code;     // Stores the process’s exit status.

  struct semaphore sema_initial;   // Synchronizes process_execute() and start_process().
  
  struct semaphore sema_wait; // Synchronizes process_wait() and process_exit().
};


// This structure tracks open files for each process.
struct open_fd
{
  int id;                // Stores the file descriptor ID, uniquely identifying an open file.
  struct list_elem elem; // Allows the file descriptor to be part of a list.
  struct file *file;     // Points to the associated file in the file system.
};


typedef int pid_t; // used to uniquely identify a process in Pintos.

#define PID_ERROR ((pid_t) - 1) // Represents an error state when a process creation or lookup fails.
